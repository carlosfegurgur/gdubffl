generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// Mirrors src/data/owners.json. id is the NFL.com account id (after alias
// consolidation for managers who've played under more than one account).
model Owner {
  id       String  @id
  name     String
  teamName String
  logoUrl  String?

  homeMatchups Matchup[]    @relation("HomeOwner")
  awayMatchups Matchup[]    @relation("AwayOwner")
  seasonTeams  SeasonTeam[]
}

// Mirrors a single matchup entry inside src/data/<season>-season.json.
model Matchup {
  id          String  @id
  season      Int
  week        Int
  homeOwner   Owner   @relation("HomeOwner", fields: [homeOwnerId], references: [id])
  homeOwnerId String
  awayOwner   Owner   @relation("AwayOwner", fields: [awayOwnerId], references: [id])
  awayOwnerId String
  homeScore   Float
  awayScore   Float
  isPlayoff   Boolean @default(false)

  @@index([season])
  @@index([homeOwnerId])
  @@index([awayOwnerId])
}

// Mirrors one owner's entry in src/data/rosters/<season>.json: their team
// for that season, final standing, and final-week roster.
model SeasonTeam {
  id       Int    @id @default(autoincrement())
  season   Int
  owner    Owner  @relation(fields: [ownerId], references: [id])
  ownerId  String
  teamId   String
  teamName String
  week     Int
  place    Int?

  players RosterPlayer[]

  @@unique([season, ownerId])
}

// One player on a SeasonTeam's final-week roster.
model RosterPlayer {
  id           Int        @id @default(autoincrement())
  seasonTeam   SeasonTeam @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)
  seasonTeamId Int
  slot         String
  name         String
  position     String
  nflTeam      String
  points       Float
  starter      Boolean

  @@index([seasonTeamId])
}
